# Скопіюйте у .env і змініть паролі: cp .env.example .env

# Підключення backend до БД
DB_HOST=db
DB_PORT=3306
DB_NAME=testapp_db
DB_USER=app
DB_PASSWORD=change-me

# Пароль root для контейнера MySQL
MYSQL_ROOT_PASSWORD=change-me-root

# Порт, на якому слухає backend всередині мережі
BACKEND_PORT=5000

# Порт на вашому комп'ютері: http://localhost:<PROXY_PORT>
PROXY_PORT=8080
