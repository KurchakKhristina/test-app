{
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "PLACEHOLDER (CI підставляє образ з тегом = git SHA)",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp",
          "name": "backend-5000-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "DB_NAME",
          "value": "testappdb"
        },
        {
          "name": "PORT",
          "value": "5000"
        },
        {
          "name": "DB_HOST",
          "value": "ecs-database-1.cqkncly2fyne.eu-central-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "3306"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:028568312595:secret:rds!db-7cc48033-8ca8-46d9-86c3-9e3a6077f6db-J928au:password::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:028568312595:secret:rds!db-7cc48033-8ca8-46d9-86c3-9e3a6077f6db-J928au:username::"
        }
      ],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecs-testap-td",
          "awslogs-create-group": "true",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "ecs-testap-td",
  "executionRoleArn": "arn:aws:iam::028568312595:role/ecsLabExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "enableFaultInjection": false
}
